# cat-now-me Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================
# Application
# ============================================
APP_NAME=cat-now-me API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ============================================
# API
# ============================================
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cat_now_me
DATABASE_ECHO=false

# ============================================
# Vector Database (ChromaDB)
# ============================================
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=documents

# ============================================
# Ollama (Local LLMs)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=codellama:13b-instruct
OLLAMA_TIMEOUT=120
OLLAMA_MODELS=codellama:13b-instruct,deepseek-coder:6.7b,llama3.1:8b,phi3:mini,nomic-embed-text

# ============================================
# Security
# ============================================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Redis (Caching, Rate Limiting, Celery)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# File Upload
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ============================================
# n8n (Automation)
# ============================================
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# ============================================
# Frontend (Next.js)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000